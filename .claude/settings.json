{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose up)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose build)",
      "Bash(docker compose build *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose run --rm backend npm ci)",
      "Bash(docker compose run --rm backend npm test)",
      "Bash(docker compose run --rm backend npm run package)",
      "Bash(docker compose run --rm frontend npm ci)",
      "Bash(docker compose run --rm frontend npm test)",
      "Bash(docker compose run --rm frontend npm run build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --stat *)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached *)",
      "Bash(git diff --name-only *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git check-ignore *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Bash(cat .env)",
      "Bash(cat */.env)",
      "Bash(git diff --no-index *)",
      "Bash(git diff * --no-index *)",
      "Bash(docker compose config)",
      "Bash(docker compose config *)",
      "Bash(docker compose * env)",
      "Bash(docker compose * printenv *)",
      "Bash(docker compose * npm run env)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-commit.sh\""
          }
        ]
      }
    ]
  }
}
